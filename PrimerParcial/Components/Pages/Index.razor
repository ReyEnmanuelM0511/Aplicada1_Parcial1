@page "/autoresIndex"
@rendermode InteractiveServer

<PageTitle>Historial de Autores</PageTitle>


<div class="container">

    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h3 class="card-title"> Registro de Autores</h3>

            <a href="/crearAutor" class="btn btn-primary">
                <span class="bi bi-plus-square mt-3"></span>Agregar Autor
            </a>

        </div>

        
        <div class="row align-items-end mb-4">

            @*labels*@
            <div class="col-md-3">

                @*Filtrar por*@
                <div>
                    <label class="form-label">
                        <strong>Filtrar por</strong>
                    </label>
                </div>

                @*ValorFiltro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*inputs y botones*@
            <div class="row align-items-center">

                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="ValorFiltro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Nombre">Nombre</option>
                        <option value="Nacionalidad">Nacionalidad</option>
                        <option value="FechaNacimiento">FechaNacimiento</option>
                        <option value="Sueldo">Sueldo</option>
                        <option value="IdAutor">IdAutor</option>

                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="input-group">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi -search" @onclick="Buscar"> Buscar</button>
                    </div>
                </div>

            </div>

            <div class="grid mt-3">
               <QuickGrid Items="@autores.AsQueryable()">
                   <PropertyColumn TGridItem="PrimerParcial.Models.Autores" TProp="int" Property="@(a => a.IdAutor)" title="Id" Sortable="true"/>
                   <PropertyColumn Property="@(a => a.Nombre)" title="Nombre" Sortable="true"/>
                   <PropertyColumn Property="@(a => a.Nacionalidad)" title="Nacionalidad" Sortable="true"/>
                   <PropertyColumn Property="@(a => a.FechaNacimiento)" title="FechaNacimiento" Sortable="true"/>
                   <PropertyColumn Property="@(a => a.Sueldo)" title="Sueldo" Sortable="true"/>
                   <TemplateColumn Title="Acciones">
                       <a href="@($"/modificar/{@context.IdAutor}")" class="btn btn-primary bi bi-pencil-square"></a>
                   </TemplateColumn>
               </QuickGrid>
            </div>
        </div>

        @*footer*@
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad:  @autores.Count()</label>
            <Label>Total Sueldos: @Suma()</Label>
        </div>
    </div>
</div>




@code {
    private string? ValorFiltro { get; set; }
    private string? filtro { get; set; }
    private Autores autor = new();

    private List<Autores> autores = new List<Autores>();

    protected override async Task OnInitializedAsync()
    {
        autores = await AutorS.GetList(a => true);
    }

    private async Task Eliminar()
    {
        bool eliminado = await AutorS.Eliminar(autor.IdAutor);

        if (eliminado)
        {
            autores = await AutorS.GetList(a => true);
            toastServices.ShowSuccess("Autor eliminado correctamente");
        }
        else
        {
            toastServices.ShowError("Error al eliminar al autor del registro");
        }
    }

    private async Task Buscar()
    {
        if(ValorFiltro == "")
        {
            autores = await AutorS.GetList(a => true);
        }
        else if (ValorFiltro?.Trim() != "" & ValorFiltro == "Nombre")
        {
            autores = await AutorS.GetList(a => a.Nombre.ToLower().Contains(ValorFiltro.ToLower()));

        } 
        else if (ValorFiltro.Trim() != "" & ValorFiltro == "Nacionalidad")
        {
            autores = await AutorS.GetList(a => a.Nacionalidad.ToLower().Contains(ValorFiltro.ToLower()));
        }
        else if (ValorFiltro == "FechaNacimiento")
        {
            if(DateOnly.TryParse(ValorFiltro, out DateOnly anio))
            {
                autores = await AutorS.GetList(a => a.FechaNacimiento == anio);
            }
        }
        else if (ValorFiltro == "Sueldo")
        {
            if(double.TryParse(ValorFiltro, out double sueldo))
            {
                autores = await AutorS.GetList(a => a.Sueldo == sueldo);
            }
        }
        else if(ValorFiltro == "IdAutor")
        {
            if(int.TryParse(ValorFiltro, out int id))
            {
                autores = await AutorS.GetList(a => a.IdAutor == id);
            }
        }
    }

    private double Suma ()
    {
        double suma = 0;

        foreach(var Autor in autores)
        {
            if(Autor.Sueldo > 0)
            {
                suma += Autor.Sueldo;
            }
        }

        return suma;
    }
}
 